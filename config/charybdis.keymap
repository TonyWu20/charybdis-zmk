#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "hold-preferred";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <10>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <200>;
};

/* Timeless homerow mods (recipe from https://github.com/urob/zmk-config#timeless-homerow-mods).
 * Balanced hold-taps that only resolve as a "hold" when the next key is on the
 * opposite hand or is a thumb key. Taps stay fast (quick-tap 175 ms and
 * require-prior-idle 150 ms), and the long 280 ms tapping term is never felt,
 * because the balanced flavor plus hold-trigger-on-release short-circuit it. */

#define KEY_L_TOP    0 1 2 3 4
#define KEY_L_HOME   10 11 12 13 14
#define KEY_L_BOTTOM 20 21 22 23 24
#define KEY_R_TOP    5 6 7 8 9
#define KEY_R_HOME   15 16 17 18 19
#define KEY_R_BOTTOM 25 26 27 28 29

#define THUMBS_L 30 31 32
#define THUMBS_R 33 34
#define THUMBS   THUMBS_L THUMBS_R

#define KEYS_L KEY_L_TOP KEY_L_HOME KEY_L_BOTTOM THUMBS_L
#define KEYS_R KEY_R_TOP KEY_R_HOME KEY_R_BOTTOM THUMBS_R

#define TIMELESS_HRM_PROPS                                                            \
    flavor = "balanced";                                                              \
    tapping-term-ms = <280>;                                                          \
    quick-tap-ms = <175>;                                                             \
    require-prior-idle-ms = <150>;                                                    \
    hold-trigger-on-release;

/ {
    chosen { zmk,matrix_transform = &five_column_transform; };
};

/ {
    combos {
        compatible = "zmk,combos";

        LeftClickRight {
            bindings = <&hrc_t_h RS(RCTRL) LCLK>;
            key-positions = <16 17>;
        };

        RightClickRight {
            bindings = <&hrc_h_o RS(RALT) RCLK>;
            key-positions = <17 18>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <26 27>;
        };
    };

    behaviors {
        Shift_Enter: Shift_Enter {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFT_ENTER";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <34>;
            tapping-term-ms = <100>;
        };

        /* Left-hand homerow mods (A, N, I, S). */
        hml: left_homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            TIMELESS_HRM_PROPS
            hold-trigger-key-positions = <KEYS_R THUMBS>;
        };

        /* Right-hand homerow mods (T, H, O, R). */
        hmr: right_homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            TIMELESS_HRM_PROPS
            hold-trigger-key-positions = <KEYS_L THUMBS>;
        };

        /* HRM-mod combos (see ZMK issue #544): combo bindings wrapped in a
           Timeless hold-tap. A quick tap fires the combo; holding the homerow
           mods still yields the natural mod chord. The hold cell is the mod
           chord of the two homerow mods; the tap cell is the combo output
           sent through &mkp. */
        hrc_n_i: hrc_n_i {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&mkp>;
            TIMELESS_HRM_PROPS
            hold-trigger-key-positions = <KEYS_R THUMBS>;
        };

        hrc_t_h: hrc_t_h {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&mkp>;
            TIMELESS_HRM_PROPS
            hold-trigger-key-positions = <KEYS_L THUMBS>;
        };

        hrc_h_o: hrc_h_o {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&mkp>;
            TIMELESS_HRM_PROPS
            hold-trigger-key-positions = <KEYS_L THUMBS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERT {
            bindings =  <
  &kp Q           &kp P           &kp Y             &kp C               &kp B        &kp V          &kp M                &kp U              &kp Z            &kp L
  &hml LEFT_WIN A &hml LEFT_ALT N &hml LEFT_SHIFT I &hml LEFT_CONTROL S &kp F        &kp D          &hmr RIGHT_CONTROL T &hmr RIGHT_SHIFT H &hmr RIGHT_ALT O &hmr RIGHT_WIN R
  &lt 1 COMMA     &lt 6 PERIOD      &kp J             &kp G               &lt 3 SLASH    &lt 3 SEMICOLON  &kp W                &kp K              &kp MINUS        &kp X
                                  &lt 4 ESCAPE      &kp E             &lt 5 TAB    &kp BACKSPACE      &lt 2 SPACE
            >;
        };

        NAV {
            bindings = <
  &kp LA(F4)  &kp LG(UP_ARROW)  &kp LG(LEFT)     &kp LG(RIGHT)          &kp LC(W)    &kp PRINTSCREEN  &kp BACKSPACE     &kp ENTER          &kp DELETE    &trans
  &kp LC(Z)   &kp RC(RS(T))     &kp LS(LC(TAB))  &kp LC(TAB)            &kp LC(A)    &kp ENTER        &kp LEFT          &kp DOWN           &kp UP_ARROW  &kp RIGHT
  &mkp LCLK   &mkp RCLK         &mkp MB3         &mt (LC(LS(V))) LC(V)  &kp LC(Y)    &trans           &kp LC(LS(LEFT))  &kp LS(LC(RIGHT))  &trans        &trans
                                &mkp MB3         &mkp MB1               &mkp MB2     &lt 3 BACKSPACE  &kp BACKSPACE
            >;
        };

        NUM {
            bindings = <
  &kp N1    &kp N2          &kp N3        &kp N4          &kp N5              &kp N6           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp N0
  &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT       &kp LEFT_CONTROL    &none            &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans
  &none     &none           &none         &none           &none               &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none
                            &trans        &kp LEFT_SHIFT  &lt 3 TAB           &trans           &trans
            >;
        };

        FUN {
            bindings = <
  &kp ESC  &kp F7  &kp F8  &kp F9  &kp F10    &bt BT_SEL 0  &bt BT_SEL 1      &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4
  &kp F12  &kp F4  &kp F5  &kp F6  &kp F11    &out OUT_TOG  &kp K_PLAY_PAUSE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &bt BT_CLR
  &bootloader   &kp F1  &kp F2  &kp F3  &kp F12    &trans        &trans            &trans             &trans           &bootloader
                   &trans  &trans  &trans     &trans        &trans
            >;
        };

        SYM {
            bindings = <
  &kp AMPERSAND     &kp AT_SIGN       &kp PERCENT      &kp TILDE          &kp CARET    &kp DOLLAR    &kp BACKSLASH   &kp MINUS     &kp SLASH          &kp HASH
  &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp LEFT_PARENTHESIS  &kp EQUAL    &kp ASTERISK  &kp RIGHT_PARENTHESIS  &kp PLUS      &kp RIGHT_BRACKET  &kp EXCLAMATION
  &kp LESS_THAN     &kp GREATER_THAN  &kp QUESTION     &kp COLON             &kp GRAVE    &kp SQT       &kp LEFT               &kp DOWN  &kp UP           &kp RIGHT
                                      &trans           &trans                &trans       &kp BACKSPACE        &mt RIGHT_SHIFT ENTER
            >;
        };

        SCROLL {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans    &trans  &trans
            >;
        };

        MSNIPE {
            bindings = <
  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans
                  &mkp RCLK  &mkp LCLK  &mkp MCLK    &trans  &trans
            >;
        };
    };
};
